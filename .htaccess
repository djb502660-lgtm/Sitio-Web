<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Sitio-Web/

    # uploads: servir desde cafeesquina/uploads (END evita bucles con .htaccess internos)
    RewriteRule ^uploads/(.*)$ cafeesquina/uploads/$1 [L,END]

    # Archivos públicos reales (incluye /assets vía junction a cafeesquina/assets)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo al front controller unificado
    RewriteRule ^ index.php [L]
</IfModule>
