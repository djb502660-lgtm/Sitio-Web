<IfModule mod_negotiation.c>
    Options -MultiViews -Indexes
</IfModule>

<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteBase /Sitio-Web/

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # uploads: carpeta física o enlace simbólico en la raíz del proyecto
    RewriteRule ^uploads/(.*)$ cafeesquina/uploads/$1 [L]

    # Archivos y carpetas reales (assets, etc.)
    RewriteCond %{REQUEST_FILENAME} -f [OR]
    RewriteCond %{REQUEST_FILENAME} -d
    RewriteRule ^ - [L]

    # Todo lo demás al front controller unificado
    RewriteRule ^ index.php [L]
</IfModule>
